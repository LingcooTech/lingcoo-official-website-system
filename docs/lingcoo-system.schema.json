{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingcoo.com/schemas/lingcoo-system.schema.json",
  "title": "Lingcoo Derived System Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "frame", "surfaces", "foundationModules", "domainModules"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "surfaces": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "foundationModules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "domainModules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
