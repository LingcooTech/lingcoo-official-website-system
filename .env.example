NODE_ENV=development
APP_NAME=lingcoo-official-website-system
APP_VERSION=development
API_HOST=0.0.0.0
API_PORT=8090
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgres://lingcoo_official:lingcoo_official_password@localhost:5438/lingcoo_official
SETTINGS_ENCRYPTION_KEY=
AUTH_JWT_SECRET=
AUTH_COOKIE_NAME=lingcoo_official_session
AUTH_SESSION_TTL_HOURS=168
AUTH_BOOTSTRAP_EMAIL=admin@lingcootech.example
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-temporary-password
AUTH_BOOTSTRAP_DISPLAY_NAME=系统管理员
WORKER_POLL_INTERVAL_MS=1000
WORKER_STALE_TIMEOUT_MS=300000
WORKER_HEALTH_PORT=8091
LOG_LEVEL=info
METRICS_BEARER_TOKEN=

POSTGRES_DB=lingcoo_official
POSTGRES_USER=lingcoo_official
POSTGRES_PASSWORD=lingcoo_official_password

LINGCOO_OFFICIAL_HTTP_PORT=80
LINGCOO_OFFICIAL_HTTPS_PORT=443
LINGCOO_OFFICIAL_RUNTIME_IMAGE=ghcr.io/lingcootech/lingcoo-official-website-system:latest
