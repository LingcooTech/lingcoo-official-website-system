NODE_ENV=development
APP_NAME=lingcoo-official-website
APP_VERSION=development
API_HOST=0.0.0.0
API_PORT=8090
PUBLIC_WEB_BASE_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-me-in-production
DATABASE_URL=postgres://lingcoo:lingcoo_password@postgres:5432/lingcoo
LOG_LEVEL=info

# 域名绑定：交付到正式服务器后由安装脚本锁定为 lingcoo.com
FD_DOMAIN_BINDING_SOURCE=none
FD_BOUND_HOST=

POSTGRES_DB=lingcoo
POSTGRES_USER=lingcoo
POSTGRES_PASSWORD=lingcoo_password

# Caddy：专用服务器上可直接设为 lingcoo.com 让 Caddy 自动签发 HTTPS
CADDY_SITE_ADDRESS=:80
LINGCOO_HTTP_PORT=80
LINGCOO_HTTPS_PORT=443
LINGCOO_RUNTIME_IMAGE=ghcr.io/lingcootech/lingcoo-official-website-system:latest
